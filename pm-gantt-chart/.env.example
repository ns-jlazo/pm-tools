# Jira integration (see skills/manage-jira/SKILL.md)
JIRA_URL=https://netskope.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional
# Jira project the "By label" story search is scoped to (labels tag a feature and
# live on stories, not epics). Defaults to SNA.
# JIRA_LABEL_PROJECT_KEY=SNA
# Custom field id holding an epic's start date (tenant-specific, e.g.
# customfield_10015). The "By label" quarter filter dates a story by its parent
# epic; without this it uses the epic's due date, then the story's due date.
# JIRA_EPIC_START_FIELD=
# JIRA_SYNC_TTL_SECONDS=300
# JIRA_DISABLE_SSL_VERIFY=0
# JIRA_RETRY_TOTAL=4
# JIRA_RETRY_BACKOFF=1.5
